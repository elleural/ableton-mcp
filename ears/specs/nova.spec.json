{
  "name": "nova",
  "version": 1,
  "source": "tetris-nova docs/soundtrack-prd.md v1.0 (2026-10-06); gaps filled from the composer's decisions in docs/handoff/soundtrack-handoff.md (2026-10-07), marked 'assumed' below",
  "key": "A minor",
  "a4_hz": 440,
  "meter": "4/4",
  "grid": 16,
  "progressions": {
    "A": ["Am", "Am", "Dm", "Dm"],
    "B": ["Am", "F", "Dm", "E"],
    "C": ["Am", "Dm", "G", "E"],
    "D": ["Am", "F", "C", "G"]
  },
  "stems": {
    "kick": {"bars": 2, "pitched": false, "role": "kick"},
    "perc": {"bars": 4, "pitched": false, "role": "perc"},
    "pad": {"bars": 16, "role": "pad"},
    "bass": {"bars": 8, "variations": ["A", "B"], "role": "bass"},
    "arp": {"bars": 8, "variations": ["A", "B"], "role": "arp"},
    "lead": {"bars": 8, "variations": ["A", "B"], "rest_share": 0.4, "role": "lead"}
  },
  "tiers": {"T1": ["pad", "arp"], "T2": ["bass"], "T3": ["kick"], "T4": ["perc"], "T5": ["lead"]},
  "sets": {
    "neon": {
      "tempos": [100, 110, 120, 130, 140, 150, 160, 170, 180],
      "variations": {"A": "A", "B": "B"},
      "tracks": "{stem}{variation}",
      "bands": [
        {"name": "LOW", "tempos": [100, 120], "scene": "NEON-LOW", "kick": "half-time"},
        {"name": "MID", "tempos": [130, 150], "scene": "NEON-MID", "kick": "four-on-the-floor"},
        {"name": "HIGH", "tempos": [160, 180], "scene": "NEON-HIGH", "kick": null}
      ],
      "default_scene": "NEON-MID",
      "fills": {"levelup_fill": {"bars": 1, "track": "fill", "scene": "NEON-FILL"}}
    },
    "mainframe": {
      "tempos": [100, 110, 120, 130],
      "variations": {"A": "A", "B": "C"},
      "variations_note": "assumed: MAINFRAME B plays progression C (Am|Dm|G|E), as composed",
      "tracks": "mf_{stem}{variation}",
      "bands": [
        {"name": "LOW", "tempos": [100, 120], "scene": "MF-LOW", "kick": "half-time"},
        {"name": "MID", "tempos": [130, 130], "scene": "MF-MID", "kick": "four-on-the-floor"}
      ],
      "bands_note": "assumed: the brief's mood bands applied to MAINFRAME's two scenes",
      "default_scene": "MF-MID",
      "fills": {"levelup_fill": {"bars": 1, "track": "mf_fill", "scene": "MF-FILL"}}
    }
  },
  "shared_pad": true,
  "loops": {
    "title": {"bars": 32, "bpm": 100, "scene": "TITLE"},
    "zone_drone": {"seconds": 32, "track": "cm_drone"}
  },
  "one_shots": {
    "zone_riser": {"seconds": 20}, "zone_drop": {"seconds": 2.5}, "gameover": {"seconds": 3},
    "results_normal": {"seconds": 4}, "results_high": {"seconds": 6}, "countdown_tick": {"seconds": 0.3},
    "countdown_go": {"seconds": 1}, "overdrive": {"seconds": 1.5}, "cascade": {"seconds": 1.5}, "quad": {"seconds": 1}
  },
  "targets": {
    "lufs_i": -14.0, "true_peak_dbtp": -1.0, "tail_ms": 50, "crossfade_ms": 10,
    "sample_rate": 48000, "bit_depth": 24, "channels": 2, "bass_crossover_hz": 120
  },
  "tolerances": {
    "lufs_i_lu": 0.5,
    "tempo_consistency_lu": 1.0,
    "mono_sub_db": 1.0,
    "sum_null_db": 40.0,
    "bar_alignment_ms": 5.0,
    "duration_ms": 1.0,
    "seam_fold_db": 30.0,
    "seam_click_db": 6.0,
    "start_ms": 5.0,
    "lead_rest_points": 10,
    "grid_ms": 10.0,
    "chord_tone_beats": [1, 3],
    "clash_sixteenths": 1,
    "compare_noise_db": 0.5,
    "phone_highpass_hz": 200
  },
  "analyser": {
    "fft_size": 2048, "smoothing": 0.5, "min_db": -90, "max_db": -20,
    "bands": {"sub": [20, 80], "low_mid": [80, 500], "high_mid": [500, 4000], "treble": [4000, 10000]},
    "attack_ms": 20, "release_ms": 200, "frame_rate": 60
  },
  "style": {
    "toward": ["dark cinematic synthwave film score", "Daft Punk Tron: Legacy score fused with synthwave"],
    "away": ["festival EDM", "generic EDM"]
  }
}
